# ============================================================
#  .env.example — copy to .env and adjust (never commit .env)
#
#    cp .env.example .env
#
#  docker-compose.yml reads .env for ${VAR} defaults and passes the
#  whole file into the app / celery / celery-beat containers, so any
#  variable added here reaches Django. Every value below has a working
#  default in docker-compose.yml — .env is optional.
#
#  Real keys (AI provider, database, hosting) go only in .env and in the
#  hosting platform's environment variables. This file keeps names and
#  invented placeholder values only; a pre-commit hook (gitleaks) blocks
#  commits that contain a key.
# ============================================================

# ── Django ────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True
# 10.0.2.2 is the Android emulator's alias for the host machine.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.0.2.2
# Browser origins allowed to call the API (a web client on another port). Empty = none.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# CSRF_TRUSTED_ORIGINS=https://example.com

# ── PostgreSQL (the db service; DATABASE_URL is built from these) ─────
POSTGRES_USER=django
POSTGRES_PASSWORD=django_pass
POSTGRES_DB=django_dev
# Or point Django at an external (managed) database instead of the db service:
# DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require
#
# ── Neon (local development and tests use the wasli-staging project) ──
# Uncomment the line below and replace it with the DIRECT connection string of the
# wasli-staging project: Neon console → Connect → turn "Connection pooling" off, so
# the host has no "-pooler" in it, and keep sslmode=require. Keep the real value only
# in .env (git-ignored). pytest creates and drops its own test_ database there.
# DATABASE_URL=postgresql://neondb_owner:replace-with-the-neon-password@ep-example-000000.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Celery Beat stays idle on an external database (it would schedule jobs there).
# Set to true to run it anyway, then: docker compose up -d celery-beat
# BEAT_ON_EXTERNAL_DATABASE=false

# ── Redis / Celery / Email are wired to the compose services by default.
# Override only if you point at external services:
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2
# EMAIL_HOST=mailpit
# EMAIL_PORT=1025

# ============================================================
#  Render environment variables (not read locally)
#
#  Render does not read this file. In each Render service open
#  Environment → Add from .env, paste the matching block below and
#  remove the leading "# " of every line (in an editor: select the block,
#  Ctrl+/). Replace every "replace-with-..." value with the real one there;
#  the real values live only in Render, never in this repository.
#
#  The production image already sets DJANGO_SETTINGS_MODULE and PORT, so
#  neither is listed. Render passes its own PORT to the container.
#  Generate each SECRET_KEY separately (never reuse one between services):
#    python -c "import secrets; print(secrets.token_urlsafe(50))"
#  The Wasli variables (demo mode, assistant provider and key, seed switch,
#  platform admin) are added here when their settings exist (docs/steps.md,
#  section 9).
# ============================================================

# ── Render service wasli-staging (auto-deploys from develop) ──────────
# DATABASE_URL=postgresql://neondb_owner:replace-with-the-staging-neon-password@ep-example-000000.eu-central-1.aws.neon.tech/neondb?sslmode=require
# SECRET_KEY=replace-with-a-generated-staging-key
# ALLOWED_HOSTS=wasli-staging.onrender.com
# CSRF_TRUSTED_ORIGINS=https://wasli-staging.onrender.com
# CORS_ALLOWED_ORIGINS=https://customer-staging.example.com,https://restaurant-staging.example.com

# ── Render service wasli-production (auto-deploys from main) ──────────
# DATABASE_URL=postgresql://neondb_owner:replace-with-the-production-neon-password@ep-example-111111.eu-central-1.aws.neon.tech/neondb?sslmode=require
# SECRET_KEY=replace-with-a-generated-production-key
# ALLOWED_HOSTS=wasli-production.onrender.com
# CSRF_TRUSTED_ORIGINS=https://wasli-production.onrender.com
# CORS_ALLOWED_ORIGINS=https://customer.example.com,https://restaurant.example.com
